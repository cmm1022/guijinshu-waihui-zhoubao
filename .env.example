# 收件邮箱（Foxmail 登录的企业邮箱，不是发件人 webdetect）
EMAIL_USER=your.name@myhexin.com
EMAIL_PASSWORD=your_client_password

# IMAP（Foxmail：右键邮箱 → 属性/账号设置 → 服务器 → 收件服务器）
# 同花顺企邮常见为 mail.myhexin.com，若 Foxmail 显示不同请以 Foxmail 为准
IMAP_HOST=mail.myhexin.com
# Foxmail 若写 995 多为 POP3；IMAP 请用 993
IMAP_PORT=993

# 周报发件人
MAIL_SENDER=webdetect@myhexin.com

# CMS https://prenewcms.wewecall.com:5443/login → 密码登录
CMS_BASE_URL=https://prenewcms.wewecall.com:5443

# --- 推荐：分租户发布（见 docs/分租户发布.md）---
# CMS_PUBLISH_MODE=per_tenant
# CMS_TENANT_PUBLISHERS=[{"name":"杭州银行","keywords":["贵金属周报"],"email":"租户邮箱","password_env":"CMS_TENANT_HZBANK_PASSWORD"}]
# CMS_TENANT_HZBANK_PASSWORD="租户密码"

# --- 运营账号（分租户模式下也会发 1 篇，默认 ths@）---
CMS_EMAIL=your_cms_login_email
# 含特殊字符时请加双引号
CMS_PASSWORD="your_cms_password"
# CMS_OPERATOR_PUBLISH=0          # 不要运营账号再发一篇
# CMS_OPERATOR_CONTENT_SYNC=1     # ths 上仍勾选「内容同步」
# CMS_FORCE_OPERATOR_SYNC=1       # 只走运营+同步，不分租户

# 新建文章编辑页（与「发布 → 文章」新开标签一致）
CMS_EDITOR_URL=https://prenewcms.wewecall.com:5443/editor/publish-home?pulishType=ARTICLE&back=contentList
# # direct：登录后直接打开编辑页（推荐）；ui：从列表点「发布→文章」
CMS_OPEN_EDITOR=direct
CMS_BROWSER_CHANNEL=msedge
# 本地调试可设 CMS_HEADLESS=0；Cursor 定时任务用 1
CMS_HEADLESS=1

# 可选：仅探测 CMS 页面结构（不发布）
# CMS_DRY_RUN=1
# 可选：试跑单篇 PUBLISH_ONLY=贵金属 或 外汇

# 可选：仅用于 scripts/sync_cursor_cloud_secrets.py 一次性同步 Cloud Secrets（勿提交）
# CURSOR_API_KEY=
